# Copy this file to .env, next to docker-compose.yml, before the first start.

# The database. Choose your own password. A database that already exists
# keeps the name, user and password it was first made with.
POSTGRES_DB=mydb
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword

# Ports on this computer for the map, the API and the database.
WEB_PORT=8080
API_PORT=7000
DB_PORT=5444
