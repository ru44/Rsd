{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rsGIS",
  "version": "0.1.0",
  "identifier": "org.rsgis.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "publisher": "ru44",
    "homepage": "https://github.com/ru44/Rsd",
    "shortDescription": "Offline 3D map with military symbols",
    "longDescription": "A 3D globe and flat map that work offline, with an MGRS grid, military symbols (MIL-STD-2525C), drawing and measuring tools and 3D volumes. Add map files (.mbtiles) you have downloaded; drawings are saved on this computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
